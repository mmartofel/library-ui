# Copy to .env.local (not committed) and fill in for your project. The crud-ui-init skill writes it for you.

# OIDC: a public client with Authorization Code + PKCE whose redirect URIs include http://localhost:5173/*.
# Tested with Keycloak; the e2e login helper (e2e/support/auth.ts) fills Keycloak's login form.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/my-realm
VITE_OIDC_CLIENT_ID=my-ui
# Dot path of the roles claim in the access token. Keycloak realm roles: realm_access.roles (the default);
# Keycloak client roles: resource_access.<client>.roles; other providers: often roles.
VITE_OIDC_ROLES_CLAIM=realm_access.roles

# The API the dev server proxies /api to.
API_PROXY_TARGET=http://localhost:8081

# Where `npm run contract:pull` reads the OpenAPI contract: a local path (e.g. ../my-api/contract/openapi.json)
# or an http(s) URL (e.g. a raw GitHub URL pinned to a tag).
CONTRACT_SOURCE=../my-api/contract/openapi.json

# Users for the e2e tests: one with the write role, one with only the read role.
E2E_WRITER_USER=my-writer
E2E_WRITER_PASSWORD=change-me
E2E_READER_USER=my-reader
E2E_READER_PASSWORD=change-me
